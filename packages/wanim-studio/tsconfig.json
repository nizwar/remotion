{
	"compilerOptions": {
		"target": "ES2018",
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"lib": ["es2015", "dom"],
		"types": [],
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noUnusedLocals": true
	},
	"include": ["src"]
}
